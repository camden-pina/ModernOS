# The genuine WebCore/JSC engine, embedded by the native ModernOS frontend.
# GLib/Soup/Skia's portable code is shared with WPE; no Linux desktop UI,
# dynamic loader, EGL, Ganesh, host browser, or hardware display is involved.
include(GNUInstallDirs)
set(PROJECT_VERSION_MAJOR 2)
set(PROJECT_VERSION_MINOR 54)
set(PROJECT_VERSION_MICRO 0)
set(PROJECT_VERSION 2.54.0)
set(WPE_API_VERSION 2.0)

find_package(Threads REQUIRED)
find_package(GLib 2.70 REQUIRED COMPONENTS GioUnix Thread Module Object)
find_package(HarfBuzz 2.7.4 REQUIRED COMPONENTS ICU)
find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
find_package(JPEG REQUIRED)
find_package(PNG REQUIRED)
find_package(WebP REQUIRED COMPONENTS demux mux)
find_package(ZLIB REQUIRED)
find_package(LibXml2 2.9.13 REQUIRED)
find_package(SQLite3 REQUIRED)
find_package(Soup3 3.0 REQUIRED)
find_package(LibGcrypt 1.7 REQUIRED)
find_package(Tasn1 REQUIRED)

WEBKIT_OPTION_BEGIN()
WEBKIT_OPTION_DEFINE(USE_LIBBACKTRACE "Use libbacktrace" PRIVATE OFF)
WEBKIT_OPTION_DEFINE(USE_SYSTEM_UNIFDEF "Use a host unifdef" PRIVATE OFF)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA PRIVATE ON)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_C_LOOP PRIVATE OFF)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO PRIVATE ON)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SOURCE PRIVATE ON)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY PRIVATE ON)
foreach(feature ENABLE_JIT ENABLE_DFG_JIT ENABLE_FTL_JIT ENABLE_WEBASSEMBLY_BBQJIT ENABLE_WEBASSEMBLY_OMGJIT
        ENABLE_SAMPLING_PROFILER ENABLE_REMOTE_INSPECTOR
        ENABLE_WEB_AUDIO ENABLE_WEBGL ENABLE_WEBGPU ENABLE_GEOLOCATION
        ENABLE_NOTIFICATIONS ENABLE_FULLSCREEN_API ENABLE_CONTEXT_MENUS
        ENABLE_GPU_PROCESS ENABLE_RESOURCE_USAGE ENABLE_MEMORY_SAMPLER
        ENABLE_PERIODIC_MEMORY_MONITOR ENABLE_MINIBROWSER ENABLE_API_TESTS
        ENABLE_LAYOUT_TESTS ENABLE_JAVASCRIPT_SHELL ENABLE_ASYNC_SCROLLING ENABLE_XSLT
        USE_LCMS USE_AVIF USE_JPEGXL)
    WEBKIT_OPTION_DEFAULT_PORT_VALUE(${feature} PRIVATE OFF)
endforeach()
WEBKIT_OPTION_END()

set(ENABLE_WEBCORE ON)
set(ENABLE_WEBKIT OFF)
set(ENABLE_WEBKIT_LEGACY OFF)
set(ENABLE_WEBINSPECTORUI OFF)
set(ENABLE_TOOLS OFF)
set(WTF_LIBRARY_TYPE STATIC)
set(JavaScriptCore_LIBRARY_TYPE STATIC)
set(WebCore_LIBRARY_TYPE STATIC)
set(MODERNOS_RASTER_ONLY ON)
# Upstream's bundled MIME parser is a target dependency, not a C++ feature.
set(USE_XDGMIME ON)
set(LOWERCASE_EVENT_LOOP_TYPE "glib")

SET_AND_EXPOSE_TO_BUILD(USE_GLIB ON)
SET_AND_EXPOSE_TO_BUILD(USE_GLIB_EVENT_LOOP ON)
SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP OFF)
SET_AND_EXPOSE_TO_BUILD(USE_SOUP ON)
SET_AND_EXPOSE_TO_BUILD(USE_GCRYPT ON)
SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ ON)
SET_AND_EXPOSE_TO_BUILD(USE_FONT_VARIANT_VIA_FEATURES ON)
SET_AND_EXPOSE_TO_BUILD(USE_THEME_ADWAITA ON)
SET_AND_EXPOSE_TO_BUILD(USE_CAIRO OFF)
SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS OFF)
SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER OFF)
SET_AND_EXPOSE_TO_BUILD(USE_LIBEPOXY OFF)
SET_AND_EXPOSE_TO_BUILD(USE_GBM OFF)
SET_AND_EXPOSE_TO_BUILD(USE_LIBDRM OFF)
SET_AND_EXPOSE_TO_BUILD(USE_ATSPI OFF)
SET_AND_EXPOSE_TO_BUILD(USE_ATK OFF)
SET_AND_EXPOSE_TO_BUILD(USE_LIBWPE OFF)
SET_AND_EXPOSE_TO_BUILD(USE_WPE_RENDERER OFF)
SET_AND_EXPOSE_TO_BUILD(USE_ANGLE OFF)
SET_AND_EXPOSE_TO_BUILD(USE_SKIA_OPENTYPE_SVG OFF)
SET_AND_EXPOSE_TO_BUILD(USE_WOFF2 OFF)
SET_AND_EXPOSE_TO_BUILD(HAVE_WOFF_SUPPORT ON)
SET_AND_EXPOSE_TO_BUILD(USE_SYSTEM_MALLOC ON)
SET_AND_EXPOSE_TO_BUILD(ENABLE_JSC_GLIB_API OFF)
SET_AND_EXPOSE_TO_BUILD(ENABLE_2022_GLIB_API ON)

# WPE's non-UI, non-GPU platform implementations are reused deliberately.
# The extra definition guards the parts that require unavailable GPU APIs.
add_definitions(-DBUILDING_WPE__=1 -DMODERNOS_RASTER_ONLY=1 -DGETTEXT_PACKAGE="ModernOS-WebCore")
