# Maintainer: Coast local ports
pkgname=ninja
pkgver=1.13.2
pkgrel=4
pkgdesc='Ninja build system, built locally with the native compiler and Python'
arch=('x86_64')
url='https://ninja-build.org/'
license=('Apache-2.0')
depends=('musl' 'gcc-libs')
makedepends=('gcc' 'python' 'patch')
source=("${BRINE_REPOSITORY_URL:-http://10.0.2.2:8765}/distfiles/ninja-$pkgver.tar.gz"
        "${BRINE_REPOSITORY_URL:-http://10.0.2.2:8765}/distfiles/ninja-session.patch"
        "${BRINE_REPOSITORY_URL:-http://10.0.2.2:8765}/distfiles/ninja_check.py")
sha256sums=('974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17'
            'ac0fa91df0d87a62f5a17325b381ca2a39d53a1e9c58ce9f99765b646a039699' '46abf4f3a175552e628670e3555ebd6e97b7cbf4e2cc2c47b04472ba168cc644')

prepare() {
    cd "$srcdir/ninja-$pkgver"
    patch -p1 -i "$srcdir/ninja-session.patch"
}

build() {
    cd "$srcdir/ninja-$pkgver"
    CXX=g++ CXXFLAGS='-O2 -g0 -fno-pie -mno-avx -mno-avx2 -D_GNU_SOURCE' \
        LDFLAGS='-static -no-pie' python configure.py --bootstrap
}

check() {
    cd "$srcdir/ninja-$pkgver"
    ./ninja --version | grep -q "$pkgver"
    python3 "$srcdir/ninja_check.py" --ninja "$PWD/ninja"
}

package() {
    cd "$srcdir/ninja-$pkgver"
    install -Dm755 ninja "$pkgdir/usr/bin/ninja"
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/ninja/COPYING"
}
