--- a/sysdeps/x86_64/stackinfo.h
+++ b/sysdeps/x86_64/stackinfo.h
@@ -32,9 +32,10 @@
 /* On x86_64 the stack grows down.  */
 #define _STACK_GROWS_DOWN	1
 
-/* Default to an executable stack.  PF_X can be overridden if PT_GNU_STACK is
- * present, but it is presumed absent.  */
-#define DEFAULT_STACK_PERMS (PF_R|PF_W|PF_X)
+/* Coast's ELF ABI uses non-executable stacks, including images without
+ * PT_GNU_STACK. Keep pthread and posix_spawn stacks consistent with that ABI.
+ * Explicit executable-stack images remain subject to the kernel's checks. */
+#define DEFAULT_STACK_PERMS (PF_R|PF_W)
 
 /* The stack can be executed at least on x86_64.  */
 #define NEED_SEPARATE_REGISTER_STACK 0
