+
+// Serialized buffers transferred from workers must retain their allocator.
+{
+  const expected = { payload: 'x'.repeat(1024 * 1024) };
+  const worker = new Worker(`
+    const assert = require('assert');
+    const v8 = require('v8');
+    const { parentPort } = require('worker_threads');
+
+    const serialized =
+      v8.serialize({ payload: 'x'.repeat(1024 * 1024) });
+
+    parentPort.postMessage(serialized, [serialized.buffer]);
+    assert.strictEqual(serialized.byteLength, 0);
+  `, { eval: true });
+
+  let serialized;
+
+  worker.once('message', common.mustCall((message) => {
+    serialized = message;
+  }));
+
+  worker.once('exit', common.mustCall((code) => {
+    assert.strictEqual(code, 0);
+    assert(serialized);
+    assert.deepStrictEqual(v8.deserialize(serialized), expected);
+  }));
+}
