 namespace internal {
 
+std::string EscapeSystemdUnitName(std::string_view name) {
+  std::string escaped;
+  for (char c : name) {
+    if (c == '/') {
+      escaped.push_back('-');
+    } else if (base::IsAsciiAlphaNumeric(c) || c == ':' || c == '_') {
+      escaped.push_back(c);
+    } else if (c == '.') {
+      if (escaped.empty()) {
+        escaped.append("\\x2e");
+      } else {
+        escaped.push_back(c);
+      }
+    } else {
+      escaped.append("\\x");
+      base::AppendHexEncodedByte(static_cast<uint8_t>(c), escaped,
+                                 /*uppercase=*/false);
+    }
+  }
+  return escaped;
+}
