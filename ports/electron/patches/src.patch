+
+#ifndef COMPONENTS_OS_CRYPT_SYNC_KEY_STORAGE_LINUX_H_
+#define COMPONENTS_OS_CRYPT_SYNC_KEY_STORAGE_LINUX_H_
+
+#include <memory>
