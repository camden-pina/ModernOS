# All build products, test images, downloads and local services live here.
/build/
/toolchain/build/
/toolchain/opt/
/toolchain/src/
/userland/bin/
/userland/obj/
/userland/runtime/

# In-tree kernel and bootloader products (also covers custom O= directories).
*.o
*.obj
*.d
*.cmd
*.a
*.lo
*.la
*.so
*.so.*
*.gch
*.pch
*.bc
*.dwo
*.gcno
*.gcda
*.pdb
*.elf
*.efi
*.fd
vmlinux
initramfs.tar
iso_root/
/arch/x86/boot/efi/loader-test
*.iso
*.img
*.qcow2
*.vmdk
*.vdi
*.raw
*.volume
*.state
*.pkg.tar.*

# CMake/Ninja state can be regenerated in custom output directories.
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
.ninja_deps
.ninja_log

# Upstream sources are fetched by checksum, never committed as archives.
/userland/vendor/**/*.tar.*
/userland/vendor/**/*.tgz
/userland/vendor/**/*.zip
/userland/vendor/**/*.whl
/userland/vendor/**/*.deb
/userland/vendor/.*.part

# Local build metadata and interrupted downloads.
/.config
/.config.old
/*.config
/*.config.old
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
target/
*.part
*.tmp
*.swp
*.swo
*~
.DS_Store
._*
/.agents/
/.aws/
/.codex/
/.vscode/
/.idea/

# Machine configuration and signing secrets. Public verification keys (*.asc)
# belong in source control; private signing state stays outside source exports.
.env
.env.*
!.env.example
*.pem.key
*.key
*.p12
*.pfx
private-keys-v1.d/
openpgp-revocs.d/
secring.gpg
trustdb.gpg
S.gpg-agent*
